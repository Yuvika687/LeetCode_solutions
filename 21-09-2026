#KOKO eating banana

class Solution:
    def minEatingSpeed(self, piles: list[int], h: int) -> int:
        l=1
        r=max(piles)
        ans=[]
        while l<=r:
            mid = l+(r-l)//2
            count =0 
            for x in piles:
                a=ceil(x/mid)
                count+=a
            if count<=h:
                ans.append(mid)
                r=mid-1
            else:
                l=mid+1
        return min(ans)
            
